{
  "name": "wms-playwright-automation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=public-smoke",
    "test:full": "playwright test",
    "test:local": "WMS_START_LOCAL_WEB=true playwright test",
    "test:firefox": "playwright test --project=firefox",
    "test:headed": "playwright test --headed",
    "test:record": "WMS_RECORD=true playwright test --headed --project=firefox",
    "test:ui": "playwright test --ui",
    "test:login": "playwright test tests/login.spec.ts",
    "test:login:headed": "playwright test tests/login.spec.ts --headed --project=firefox",
    "test:login:record": "WMS_RECORD=true playwright test tests/login.spec.ts --headed --project=firefox",
    "test:finance": "playwright test tests/finance-report.spec.ts",
    "codegen": "playwright codegen --browser=firefox https://mywms-686.pages.dev",
    "codegen:login": "playwright codegen --browser=firefox https://mywms-686.pages.dev/login",
    "install:browsers": "playwright install firefox",
    "install:firefox": "playwright install firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.5",
    "dotenv": "^17.4.2"
  }
}
