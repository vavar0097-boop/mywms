# This template is for local development. Vercel sets production NODE_ENV.
NODE_ENV=development

PORT=3000

# Comma-separated browser origins allowed by the production API.
# Set the deployed Cloudflare Pages origin(s) in Vercel's environment settings.
CLIENT_ORIGIN=https://mywms-686.pages.dev

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

SUPABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection for database scripts.
# Either fill DATABASE_URL or fill SUPABASE_DB_PASSWORD when
# supabase/.temp/pooler-url exists.
DATABASE_URL=

# SUPABASE_DB_PASSWORD=

# Optional AI parser for daily purchase notes.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Google Sheets sync for finance monthly reports.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
