NODE_ENV=development

PORT=3000

# Comma-separated allowed browser origins for cookie/CORS auth.
# Example: http://localhost:5173,https://your-site.pages.dev
CLIENT_ORIGIN=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

SUPABASE_URL=

SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Direct Postgres connection for database scripts.
# Either fill DATABASE_URL or fill SUPABASE_DB_PASSWORD when
# supabase/.temp/pooler-url exists.
DATABASE_URL=

# SUPABASE_DB_PASSWORD=

JWT_ACCESS_SECRET=

JWT_REFRESH_SECRET=

# Optional AI parser for daily purchase notes.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Google Sheets sync for finance monthly reports.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
